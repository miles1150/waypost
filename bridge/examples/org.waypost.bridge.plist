<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.waypost.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/.local/bin/waypost-bridge</string>
        <string>--config</string>
        <string>/Users/USERNAME/.config/waypost-bridge/config.json</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
